# ============================================================
#  DrinKit — environment keys
#  Copy this file to `.env` and fill in whatever you have.
#  EVERY key is OPTIONAL. Missing keys => that feature runs in
#  fully-working DEMO mode. Fill them in to go "live".
#  See SETUP.md for step-by-step instructions on getting each key.
#
#  NOTE: Vite inlines VITE_* at BUILD time. After editing .env
#  you must restart `npm run dev` (or rebuild). On Vercel, add
#  these in Project → Settings → Environment Variables. For Docker,
#  pass them as --build-arg (see SETUP.md).
# ============================================================

# ---- Firebase (phone-number OTP login) ----
# Empty => demo OTP mode: on-screen code 123456 logs you in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ---- Google Maps (location picker + rider map) ----
# Empty => built-in SVG mini-map (drag pin, geolocate) is used instead.
VITE_GOOGLE_MAPS_API_KEY=

# ---- Razorpay (payments) ----
# Use a TEST key id (rzp_test_...) first. Empty => demo payment sheet.
VITE_RAZORPAY_KEY_ID=

# ---- EmailJS (send each order to your inbox) ----
# Empty => order summary is logged to the browser console instead of emailed.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Where order emails are sent (used inside the EmailJS template as {{order_email}}).
VITE_ORDER_EMAIL=imvishalbhargav@gmail.com
